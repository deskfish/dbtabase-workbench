{
  auto_https off
}

:80 {
  encode zstd gzip
  header {
    Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
  }
  @backend path /api/* /health/*
  reverse_proxy @backend api:8080
  reverse_proxy web:8080
}
